# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas connection string, or local mongodb://127.0.0.1:27017/shanan_gibe_union)
MONGO_URI=mongodb://127.0.0.1:27017/shanan_gibe_union

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
